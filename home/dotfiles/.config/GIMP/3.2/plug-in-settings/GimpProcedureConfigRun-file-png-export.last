# settings

(interlaced no)
(compression 0)
(bkgd no)
(offs no)
(phys yes)
(time yes)
(save-transparent no)
(optimize-palette no)
(format "auto")
(include-exif no)
(include-iptc no)
(include-xmp no)
(include-color-profile no)
(include-thumbnail no)
(include-comment yes)
(gimp-comment "Created with GIMP\nNO AI USED!!!!!")

# end of settings
